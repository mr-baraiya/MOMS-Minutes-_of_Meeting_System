generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int        @id @default(autoincrement()) @map("user_id")
  username         String     @unique @db.VarChar(100)
  email            String     @unique @db.VarChar(150)
  passwordHash     String     @map("password_hash") @db.VarChar(255)
  role             Role       @default(STAFF)
  profilePicture   String?    @map("profile_picture") @db.VarChar(255)
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  modifiedAt       DateTime   @updatedAt @map("modified_at")
  resetToken       String?    @map("reset_token") @db.VarChar(255)
  resetTokenExpiry DateTime?  @map("reset_token_expiry")
  documents        Document[]
  reports          Report[]
  supportTickets   SupportTicket[]
  notifications    Notification[]
  staff            Staff?

  @@map("users")
}

model Department {
  id             Int      @id @default(autoincrement()) @map("department_id")
  departmentName String   @unique @map("department_name") @db.VarChar(100)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  staff          Staff[]

  @@map("department")
}

model Staff {
  id                Int             @id @default(autoincrement()) @map("staff_id")
  userId            Int             @unique @map("user_id")
  staffName         String          @map("staff_name") @db.VarChar(150)
  designation       String?         @db.VarChar(100)
  mobileNo          String?         @map("mobile_no") @db.VarChar(15)
  emailAddress      String          @unique @map("email_address") @db.VarChar(150)
  departmentId      Int?            @map("department_id")
  profilePicture    String?         @map("profile_picture") @db.VarChar(255)
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  meetingMembers    MeetingMember[]
  organizedMeetings Meeting[]       @relation("Organizer")
  department        Department?     @relation(fields: [departmentId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff")
}

model MeetingType {
  id              Int       @id @default(autoincrement()) @map("meeting_type_id")
  meetingTypeName String    @unique @map("meeting_type_name") @db.VarChar(100)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  meetings        Meeting[]

  @@map("meeting_type")
}

model Venue {
  id        Int       @id @default(autoincrement()) @map("venue_id")
  venueName String    @map("venue_name") @db.VarChar(150)
  venueType VenueType @default(PHYSICAL) @map("venue_type")
  location  String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  meetings  Meeting[]

  @@map("venue")
}

model Meeting {
  id                 Int             @id @default(autoincrement()) @map("meeting_id")
  meetingTitle       String          @map("meeting_title") @db.VarChar(255)
  meetingDescription String?         @map("meeting_description")
  meetingDate        DateTime        @map("meeting_date") @db.Date
  meetingStartTime   DateTime        @map("meeting_start_time")
  meetingEndTime     DateTime        @map("meeting_end_time")
  meetingTypeId      Int?            @map("meeting_type_id")
  organizerStaffId   Int?            @map("organizer_staff_id")
  venueId            Int?            @map("venue_id")
  meetingLink        String?         @map("meeting_link")
  isCancelled        Boolean         @default(false) @map("is_cancelled")
  cancellationReason String?         @map("cancellation_reason")
  cancelledAt        DateTime?       @map("cancelled_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  modifiedAt         DateTime        @updatedAt @map("modified_at")
  documents          Document[]
  meetingMembers     MeetingMember[]
  meetingType        MeetingType?    @relation(fields: [meetingTypeId], references: [id])
  organizer          Staff?          @relation("Organizer", fields: [organizerStaffId], references: [id])
  venue              Venue?          @relation(fields: [venueId], references: [id])
  reports            Report[]

  @@map("meetings")
}

model MeetingMember {
  id                 Int       @id @default(autoincrement()) @map("meeting_member_id")
  meetingId          Int       @map("meeting_id")
  staffId            Int       @map("staff_id")
  isPresent          Boolean   @default(false) @map("is_present")
  attendanceMarkedAt DateTime? @map("attendance_marked_at")
  remarks            String?
  createdAt          DateTime  @default(now()) @map("created_at")
  meeting            Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  staff              Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([meetingId, staffId])
  @@map("meeting_member")
}

model Document {
  id            Int      @id @default(autoincrement()) @map("document_id")
  meetingId     Int      @map("meeting_id")
  documentTitle String   @map("document_title") @db.VarChar(255)
  fileName      String   @map("file_name") @db.VarChar(255)
  filePath      String   @map("file_path")
  uploadedBy    Int      @map("uploaded_by")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")
  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploader      User     @relation(fields: [uploadedBy], references: [id])

  @@map("documents")
}

model Report {
  id          Int        @id @default(autoincrement()) @map("report_id")
  reportName  String     @map("report_name") @db.VarChar(255)
  reportType  ReportType @map("report_type")
  meetingId   Int?       @map("meeting_id")
  filePath    String     @map("file_path")
  generatedBy Int        @map("generated_by")
  generatedAt DateTime   @default(now()) @map("generated_at")
  generator   User       @relation(fields: [generatedBy], references: [id])
  meeting     Meeting?   @relation(fields: [meetingId], references: [id])

  @@map("reports")
}

model SupportTicket {
  id        Int                 @id @default(autoincrement()) @map("ticket_id")
  userId    Int                 @map("user_id")
  category  SupportCategory     @map("category")
  subject   String              @db.VarChar(200)
  message   String
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

model Notification {
  id          Int              @id @default(autoincrement()) @map("notification_id")
  userId      Int              @map("user_id")
  title       String           @db.VarChar(200)
  message     String
  type        NotificationType @map("type")
  referenceId Int?             @map("reference_id")
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum Role {
  ADMIN
  CONVENER
  STAFF
}

enum NotificationType {
  MEETING_CREATED
  MEETING_UPDATED
  MEETING_CANCELLED
  ATTENDANCE_MARKED
  DOCUMENT_UPLOADED
  REPORT_GENERATED
  SUPPORT_TICKET_UPDATED
  GENERAL
}

enum VenueType {
  PHYSICAL
  VIRTUAL
}

enum ReportType {
  SUMMARY
  MEETING_WISE
}

enum SupportCategory {
  MEETING_ISSUE
  ACCESS_LOGIN
  DOCUMENTS_MOM
  REPORTS
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}
